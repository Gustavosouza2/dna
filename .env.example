# =============================================================
# Dna Air Cargo — variáveis de ambiente
# Copie para .env.local (dev) ou configure no painel/servidor da
# Hostinger (produção). NUNCA comite .env.local.
# =============================================================

# -------- Domínio público do site --------
# Usado em: metadataBase (canonical + Open Graph), sitemap.xml e
# robots.txt. É lido NO BUILD (essas rotas são estáticas) — mudar
# depois do build não tem efeito, é preciso rebuildar.
# Sem valor, o build falha de propósito (lib/site.ts).
# Dev:  http://localhost:3000
# Prod: https://www.dnaircargo.com.br   (use exatamente o host final,
#       com ou sem "www", o mesmo que você configurar na Hostinger)
NEXT_PUBLIC_SITE_URL=https://www.dnaircargo.com.br

# -------- Resend (envio dos formulários de orçamento/contato) --------
# Chave da API (painel Resend > API Keys). Use uma chave SEPARADA para
# produção — não reaproveite a de desenvolvimento.
# Sem ela, os formulários respondem 502 e o log mostra
# "RESEND_API_KEY não configurada".
RESEND_API_KEY=

# Domínio verificado no Resend (Domains > Add Domain), sem @ e sem
# https. O remetente vira site@<esse domínio>.
# Em branco = modo sandbox: remetente onboarding@resend.dev e entrega
# SOMENTE para o e-mail dono da conta Resend. Isso NÃO serve para
# produção — verifique o domínio antes de publicar.
RESEND_SENDING_DOMAIN=dnaircargo.com.br

# Caixa que recebe as notificações de contato/orçamento.
# Obrigatória: sem ela o envio retorna "not_configured" (não existe
# fallback embutido, para não mandar leads reais para o inbox errado).
# Deliberadamente separada do e-mail público exibido no site
# (lib/constants.ts CONTACT.email).
RESEND_TO_EMAIL=contato@dnaircargo.com.br

# -------- Testes --------
# Dry-run do envio de e-mail (ADR 0011): loga em vez de enviar.
# Só para dev/E2E. Em produção é ignorado por segurança
# (lib/data/email.ts), mas NÃO defina esta variável no servidor.
E2E_TEST_MODE=false
